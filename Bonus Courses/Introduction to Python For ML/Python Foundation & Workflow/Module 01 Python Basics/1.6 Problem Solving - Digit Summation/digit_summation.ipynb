   "source": [
    "inp = input()\n",
    "\n",
    "numbers = inp.split()\n",
    "\n",
    "num_1 = int(numbers[0])\n",
    "\n",
    "num_2 = int(numbers[1])\n",
    "\n",
    "last_digit_of_num_1 = num_1 % 10\n",
    "\n",
    "last_digit_of_num_2 = num_2 % 10\n",
    "\n",
    "sum = last_digit_of_num_1 + last_digit_of_num_2\n",
    "\n",
    "print(sum)"
   ]
  }
